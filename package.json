{
  "name": "superagent-skill",
  "version": "0.2.0",
  "type": "module",
  "description": "A headless, file-backed agent that turns requests from GitHub issues or Feishu chats into tickets and runs each ticket on a configurable coding agent: Claude Code, Codex or opencode.",
  "bin": {
    "superagent": "bin/superagent.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "tsdown"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "keywords": [
    "agent",
    "claude-code",
    "codex",
    "opencode",
    "feishu",
    "github",
    "automation",
    "tickets"
  ],
  "files": [
    "bin",
    "lib",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "prompts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smallnest/superagent.git"
  },
  "homepage": "https://github.com/smallnest/superagent",
  "bugs": {
    "url": "https://github.com/smallnest/superagent/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
